# Database — Render injects this automatically from render.yaml.
# Local development can omit it and use SQLite at ./data/assetpulse.db
DATABASE_URL=

# Public URL, used in emails and social meta tags
APP_URL=https://assetpulse.app

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=AssetPulse
BREVO_TEST_MODE=false

# Web push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@yourdomain.com

PORT=3000
